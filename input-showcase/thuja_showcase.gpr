with "thuja";

project Thuja_Showcase is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("showcase.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatwe", "-gnatVa", "-g", "-O1");
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use ("-Es");
   end Binder;

   package Linker is
      case Thuja.OS is
         when "windows" =>
            --  A frame lives on the stack and can reach 1 MB on a very
            --  large terminal; the Windows default stack is 2 MB.
            for Default_Switches ("Ada") use ("-Wl,--stack,8388608");
         when others =>
            null;
      end case;
   end Linker;

end Thuja_Showcase;
